{
  "name": "gst-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "create-user": "node --env-file=.env.local scripts/create-user.mjs",
    "dev:vinext": "vinext dev --port 3001",
